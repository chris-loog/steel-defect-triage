# Copy to .env and adjust. Never commit .env.

# URL the .NET backend uses to reach the Python defect classifier service.
# ASP.NET Core maps "__" to a config section: overrides ForecastApi:BaseUrl in appsettings.json.
ForecastApi__BaseUrl=http://localhost:8000

# LLM provider for the handover note. Overrides the "Llm" section in appsettings.json.
# Ollama runs on the host, no API key needed. It binds to the docker0 IP 172.17.0.1 so containers can reach it.
# In Docker Compose the backend uses http://host.docker.internal:11434 (set in compose.yaml).
Llm__Provider=ollama
Llm__Ollama__BaseUrl=http://172.17.0.1:11434
Llm__Ollama__Model=qwen3.5
