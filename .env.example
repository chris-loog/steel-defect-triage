# Copy to .env and adjust. Never commit .env.

# URL the .NET backend uses to reach the Python forecasting service.
# ASP.NET Core maps "__" to a config section: overrides ForecastApi:BaseUrl in appsettings.json.
ForecastApi__BaseUrl=http://localhost:8000

# LLM provider (Stage 8). Ollama runs locally, no API key needed.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5
