# Copy to .env and adjust. Never commit .env.

# URL the .NET backend uses to reach the Python defect classifier service.
# ASP.NET Core maps "__" to a config section: overrides ClassifierApi:BaseUrl in appsettings.json.
ClassifierApi__BaseUrl=http://localhost:8000

# LLM provider for the handover note. Overrides the "Llm" section in appsettings.json.
# Ollama runs on the host, no API key needed. It binds to the docker0 IP 172.17.0.1 so containers can reach it.
# In Docker Compose the backend uses http://host.docker.internal:11434 (set in compose.yaml).
Llm__Provider=ollama
Llm__Ollama__BaseUrl=http://172.17.0.1:11434
Llm__Ollama__Model=qwen3.5

# Alternative: Azure OpenAI (used by the Azure deployment). Set Llm__Provider=azureopenai.
# Endpoint = https://<resource>.openai.azure.com, Deployment = model deployment name in Azure.
# The key belongs in .env / a Container App secret only – never in appsettings.json.
# Llm__AzureOpenAI__Endpoint=https://<resource>.openai.azure.com
# Llm__AzureOpenAI__Deployment=gpt-4.1-mini
# Llm__AzureOpenAI__ApiKey=<your-key>
