# Copy to .env and adjust. Never commit .env.

# URL the .NET backend uses to reach the Python forecasting service.
# ASP.NET Core maps "__" to a config section: overrides ForecastApi:BaseUrl in appsettings.json.
ForecastApi__BaseUrl=http://localhost:8000

# LLM provider (Stage 8). Overrides the "Llm" section in appsettings.json.
# Ollama runs locally, no API key needed.
Llm__Provider=ollama
Llm__Ollama__BaseUrl=http://localhost:11434
Llm__Ollama__Model=qwen3.5
