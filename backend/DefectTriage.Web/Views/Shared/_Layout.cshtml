<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Steel Defect Triage</title>
    <link rel="preload" href="~/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/barlow-condensed-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container site-header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" asp-route-seed="">Steel Defect Triage</a>
            @await RenderSectionAsync("HeaderActions", required: false)
        </div>
    </header>

    <main class="container site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            Data: <a href="https://doi.org/10.24432/C5J88N">UCI Steel Plates Faults</a> by Buscema, Terzi and Tastle (2010),
            licensed CC BY 4.0. Fonts: Barlow, SIL Open Font License.
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
