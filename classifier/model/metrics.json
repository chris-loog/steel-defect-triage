{
  "data": "UCI Steel Plates Faults (Buscema, Terzi & Tastle 2010, CC BY 4.0, doi:10.24432/C5J88N)",
  "target": "fault",
  "classes": [
    "Bumps",
    "Dirtiness",
    "K_Scatch",
    "Other_Faults",
    "Pastry",
    "Stains",
    "Z_Scratch"
  ],
  "model": "gradient_boosting",
  "features": [
    "Pixels_Areas",
    "X_Perimeter",
    "Y_Perimeter",
    "Sum_of_Luminosity",
    "Minimum_of_Luminosity",
    "Maximum_of_Luminosity",
    "Length_of_Conveyer",
    "TypeOfSteel_A300",
    "Steel_Plate_Thickness",
    "Edges_Index",
    "Empty_Index",
    "Square_Index",
    "Outside_X_Index",
    "Edges_X_Index",
    "Edges_Y_Index",
    "Outside_Global_Index",
    "LogOfAreas",
    "Log_X_Index",
    "Log_Y_Index",
    "Orientation_Index",
    "Luminosity_Index",
    "SigmoidOfAreas"
  ],
  "dropped_features": {
    "TypeOfSteel_A400": "always 1 - TypeOfSteel_A300 (redundant)",
    "X_Minimum": "absolute plate position (leakage check)",
    "X_Maximum": "absolute plate position (leakage check)",
    "Y_Minimum": "absolute plate position (leakage check)",
    "Y_Maximum": "absolute plate position (leakage check)"
  },
  "split": {
    "test_size": 0.2,
    "stratified": true,
    "seed": 42,
    "n_train": 1552,
    "n_test": 389
  },
  "cv_macro_f1": {
    "baseline_most_frequent": 0.074,
    "random_forest": 0.758,
    "gradient_boosting": 0.771
  },
  "test": {
    "baseline_most_frequent": {
      "accuracy": 0.347,
      "macro_f1": 0.074
    },
    "random_forest": {
      "accuracy": 0.784,
      "macro_f1": 0.786
    },
    "gradient_boosting": {
      "accuracy": 0.789,
      "macro_f1": 0.789
    }
  },
  "leakage_check": {
    "model": "gradient_boosting",
    "cv_macro_f1": {
      "with_position": 0.794,
      "without_position": 0.771,
      "with_y_position": 0.787,
      "position_only": 0.498
    },
    "gain_from_position": 0.023,
    "decision": "dropped: small gain (~0.01-0.03, CV-seed dependent), only from Y, no physical explanation"
  },
  "per_class_test": {
    "Bumps": {
      "precision": 0.731,
      "recall": 0.704,
      "f1-score": 0.717,
      "support": 81.0
    },
    "Dirtiness": {
      "precision": 0.571,
      "recall": 0.727,
      "f1-score": 0.64,
      "support": 11.0
    },
    "K_Scatch": {
      "precision": 0.973,
      "recall": 0.91,
      "f1-score": 0.94,
      "support": 78.0
    },
    "Other_Faults": {
      "precision": 0.721,
      "recall": 0.785,
      "f1-score": 0.752,
      "support": 135.0
    },
    "Pastry": {
      "precision": 0.645,
      "recall": 0.625,
      "f1-score": 0.635,
      "support": 32.0
    },
    "Stains": {
      "precision": 1.0,
      "recall": 0.857,
      "f1-score": 0.923,
      "support": 14.0
    },
    "Z_Scratch": {
      "precision": 0.971,
